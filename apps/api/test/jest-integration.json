{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".integration.spec.ts$",
  "setupFiles": ["<rootDir>/setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@ule/contracts$": "<rootDir>/../../packages/contracts/src/index.ts"
  }
}
