{
  "name": "@ule/api",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Learning Engine Backend API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --config jest.config.ts --passWithNoTests",
    "test:integration": "jest --config test/jest-integration.json --runInBand --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.14",
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@ule/contracts": "workspace:*",
    "better-auth": "1.7.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
