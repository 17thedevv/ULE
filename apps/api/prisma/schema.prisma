// Prisma schema for ULE (Universal Learning Engine)
// Phase 1A: Course Core, Ownership & Versioning
// Phase 1B: Activity Block Protocol & Minimal Runtime

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Phase 0: Provisional Probe (Kept for migration baseline)
// ----------------------------------------------------
model ProvisionalMigrationProbe {
  id        String   @id @default(uuid())
  probedAt  DateTime @default(now())
  probeNote String   @default("Phase 0 bootstrap migration validation probe")

  @@map("provisional_migration_probes")
}

// ----------------------------------------------------
// Authentication Domain (Better Auth Canonical Models)
// ----------------------------------------------------
model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false)
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sessions        Session[]
  accounts        Account[]
  courses         Course[]
  createdVersions CourseVersion[] @relation("UserCreatedVersions")
  runs            ABRun[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  mcpAuditLogs       McpAuditLog[]
  mcpIdempotencies   McpMutationIdempotency[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ----------------------------------------------------
// Course Core Domain (Course, CourseDraft, CourseVersion)
// ----------------------------------------------------

enum CourseVisibility {
  PRIVATE
  PUBLIC
}

/// Represents the stable Course identity and authoritative owner.
/// In Phase 1A, visibility is PRIVATE by default, and public publication
/// is strictly disallowed without future editorial review.
model Course {
  id         String           @id @default(uuid())
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility CourseVisibility @default(PRIVATE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  draft      CourseDraft?
  versions   CourseVersion[]

  @@index([ownerId])
  @@map("courses")
}

/// Represents the current editable authoring state for a Course.
model CourseDraft {
  id              String               @id @default(uuid())
  courseId        String               @unique
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  summary         String?
  revision        Int                  @default(1)
  sourceVersionId String?
  sourceVersion   CourseVersion?       @relation("DraftSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  updatedAt       DateTime             @updatedAt

  blocks          DraftBlockInstance[]

  @@map("course_drafts")
}

/// Represents an immutable version snapshot created from a validated CourseDraft.
model CourseVersion {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  description   String?
  summary       String?
  snapshot      Json
  schemaVersion String       @default("1.0.0")
  draftRevision Int
  createdById   String
  createdBy     User         @relation("UserCreatedVersions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  derivedDrafts CourseDraft[] @relation("DraftSourceVersion")
  runs          ABRun[]

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@index([createdById])
  @@map("course_versions")
}

// ----------------------------------------------------
// ABP Domain (Activity Block Protocol & Runtime)
// ----------------------------------------------------

enum RunStatus {
  CREATED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum RunCloseReason {
  COMPLETED
  ABANDONED
  FAILED
}

enum AssessmentStatus {
  EVALUATED
  SKIPPED
  FAILED
}

model DraftBlockInstance {
  id          String      @id @default(uuid())
  draftId     String
  draft       CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  blockTypeId String
  typeVersion String      @default("1.0.0")
  title       String
  orderIndex  Int         @default(0)
  config      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([draftId])
  @@index([draftId, orderIndex])
  @@map("draft_block_instances")
}

model ABRun {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   CourseVersion   @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  blockInstanceId String
  blockTypeId     String
  typeVersion     String          @default("1.0.0")
  status          RunStatus       @default(CREATED)
  closeReason     RunCloseReason?
  failureDetails  String?
  startedAt       DateTime?
  closedAt        DateTime?
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attempts          ABAttempt[]
  events            ABEvent[]
  assessmentResults AssessmentResult[]

  @@index([userId])
  @@index([courseVersionId])
  @@index([courseVersionId, blockInstanceId])
  @@map("ab_runs")
}

model ABAttempt {
  id                String            @id @default(uuid())
  runId             String
  run               ABRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  submittedResponse Json
  assisted          Boolean           @default(false)
  supportContext    Json?
  idempotencyKey    String?
  createdAt         DateTime          @default(now())

  assessmentResult  AssessmentResult?

  @@unique([runId, attemptNumber])
  @@unique([runId, idempotencyKey])
  @@index([runId])
  @@map("ab_attempts")
}

model AssessmentResult {
  id          String           @id @default(uuid())
  attemptId   String?          @unique
  attempt     ABAttempt?       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  runId       String
  run         ABRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  status      AssessmentStatus @default(EVALUATED)
  isCorrect   Boolean?
  score       Float?
  feedback    Json?
  evaluatorId String
  evaluatedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())

  @@index([runId])
  @@map("assessment_results")
}

model ABEvent {
  id              String   @id @default(uuid())
  runId           String
  run             ABRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json?
  idempotencyKey  String?
  serverTimestamp DateTime @default(now())

  @@unique([runId, idempotencyKey])
  @@index([runId])
  @@index([runId, serverTimestamp])
  @@map("ab_events")
}

// ----------------------------------------------------
// OAuth 2.1 & Better Auth MCP Provider Domain
// ----------------------------------------------------

model Jwks {
  id         String    @id @default(uuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(uuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?             @default(now())
  updatedAt                        DateTime?             @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthClientResources             OauthClientResource[]
  oauthRefreshTokens               OauthRefreshToken[]
  oauthAccessTokens                OauthAccessToken[]
  oauthConsents                    OauthConsent[]

  @@index([userId])
  @@map("oauth_clients")
}

model OauthResource {
  id                            String                @id @default(uuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @default(now())
  updatedAt                     DateTime?             @updatedAt
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthClientResources          OauthClientResource[]

  @@map("oauth_resources")
}

model OauthClientResource {
  id            String        @id @default(uuid())
  clientId      String
  oauthClient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthResource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?     @default(now())

  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthRefreshToken {
  id                      String             @id @default(uuid())
  token                   String             @unique
  clientId                String
  oauthClient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthAccessTokens       OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String             @id @default(uuid())
  token                   String?            @unique
  clientId                String
  oauthClient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  oauthRefreshToken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id                      String      @id @default(uuid())
  clientId                String
  oauthClient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?   @default(now())
  updatedAt               DateTime?   @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

model OauthClientAssertion {
  id        String   @id @default(uuid())
  expiresAt DateTime

  @@map("oauth_client_assertions")
}

// ----------------------------------------------------
// MCP Authoring Audit & Idempotency Domain
// ----------------------------------------------------

model McpAuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  toolName       String
  action         String
  resourceType   String
  resourceId     String?
  idempotencyKey String?
  status         String
  details        Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([toolName])
  @@index([idempotencyKey])
  @@index([status])
  @@map("mcp_audit_logs")
}

model McpMutationIdempotency {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String   @default("unknown_client")
  toolName       String
  idempotencyKey String
  payloadHash    String
  resourceId     String?
  ownerToken     String?
  fenceToken     Int      @default(1)
  leaseExpiresAt DateTime?
  status         String   @default("COMPLETED")
  response       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, clientId, toolName, idempotencyKey])
  @@index([userId])
  @@index([clientId])
  @@index([resourceId])
  @@index([status, leaseExpiresAt])
  @@index([fenceToken])
  @@map("mcp_mutation_idempotencies")
}
