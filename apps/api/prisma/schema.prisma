// Prisma schema for ULE (Universal Learning Engine)
// Phase 1A: Course Core, Ownership & Versioning
// Phase 1B: Activity Block Protocol & Minimal Runtime
// Phase 2: Model Context Protocol (MCP) Authoring & OAuth 2.1
// Phase 3: Trusted Learning Evidence & Minimal LII Foundation

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Phase 0: Provisional Probe (Kept for migration baseline)
// ----------------------------------------------------
model ProvisionalMigrationProbe {
  id        String   @id @default(uuid())
  probedAt  DateTime @default(now())
  probeNote String   @default("Phase 0 bootstrap migration validation probe")

  @@map("provisional_migration_probes")
}

// ----------------------------------------------------
// Authentication Domain (Better Auth Canonical Models)
// ----------------------------------------------------
model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false)
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sessions           Session[]
  accounts           Account[]
  courses            Course[]
  createdVersions    CourseVersion[]          @relation("UserCreatedVersions")
  runs               ABRun[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  mcpAuditLogs       McpAuditLog[]
  mcpIdempotencies   McpMutationIdempotency[]

  // Phase 3 relations
  learnerGrants       CourseAccessGrant[]      @relation("LearnerGrants")
  grantedAccessGrants CourseAccessGrant[]      @relation("GrantedByOwner")
  learningEvidence    LearningEvidence[]       @relation("UserLearningEvidence")
  skillProjections    LearnerSkillProjection[] @relation("UserSkillProjections")

  // Phase 4 relations
  enrollments     CourseEnrollment[] @relation("UserEnrollments")
  questInstances  QuestInstance[]    @relation("UserQuestInstances")
  qualifyingFacts QualifyingFact[]   @relation("UserQualifyingFacts")

  // Phase 5.5 Assessment relations
  questionBankItems         QuestionBankItem[]     @relation("UserQuestionBankItems")
  createdQuestionVersions   QuestionVersion[]      @relation("UserCreatedQuestionVersions")
  assessmentDefinitions     AssessmentDefinition[] @relation("UserAssessmentDefinitions")
  createdAssessmentVersions AssessmentVersion[]    @relation("UserCreatedAssessmentVersions")

  // Phase 5.5 Exam Runtime relations
  examAccessGrants        ExamAccessGrant[] @relation("LearnerExamGrants")
  grantedExamAccessGrants ExamAccessGrant[] @relation("GrantedByExamCreator")
  examAttempts            ExamAttempt[]     @relation("LearnerExamAttempts")

  // Phase 5.5 Human Grading & Appeals relations
  learnerAppeals          ExamGradeAppeal[] @relation("LearnerExamAppeals")
  reviewedAppeals         ExamGradeAppeal[] @relation("ReviewerExamAppeals")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ----------------------------------------------------
// Course Core Domain (Course, CourseDraft, CourseVersion)
// ----------------------------------------------------

enum CourseVisibility {
  PRIVATE
  PUBLIC
}

/// Represents the stable Course identity and authoritative owner.
/// In Phase 1A, visibility is PRIVATE by default, and public publication
/// is strictly disallowed without future editorial review.
model Course {
  id         String           @id @default(uuid())
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility CourseVisibility @default(PRIVATE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  draft        CourseDraft?
  versions     CourseVersion[]
  skills       CourseSkill[]
  accessGrants CourseAccessGrant[]

  // Phase 5.5 Assessment relations
  questionBankItems     QuestionBankItem[]     @relation("CourseQuestionBankItems")
  assessmentDefinitions AssessmentDefinition[] @relation("CourseAssessmentDefinitions")

  @@index([ownerId])
  @@map("courses")
}

/// Represents the current editable authoring state for a Course.
model CourseDraft {
  id              String               @id @default(uuid())
  courseId        String               @unique
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  summary         String?
  revision        Int                  @default(1)
  sourceVersionId String?
  sourceVersion   CourseVersion?       @relation("DraftSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  updatedAt       DateTime             @updatedAt

  blocks        DraftBlockInstance[]
  skillMappings DraftSkillMapping[]
  quests        DraftCourseQuest[]

  @@map("course_drafts")
}

/// Represents an immutable version snapshot created from a validated CourseDraft.
model CourseVersion {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  description   String?
  summary       String?
  snapshot      Json
  schemaVersion String       @default("1.0.0")
  draftRevision Int
  createdById   String
  createdBy     User         @relation("UserCreatedVersions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  derivedDrafts    CourseDraft[]            @relation("DraftSourceVersion")
  runs             ABRun[]
  accessGrants     CourseAccessGrant[]
  learningEvidence LearningEvidence[]
  skillProjections LearnerSkillProjection[]
  enrollments      CourseEnrollment[]
  questInstances   QuestInstance[]
  qualifyingFacts  QualifyingFact[]

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@index([createdById])
  @@map("course_versions")
}

// ----------------------------------------------------
// ABP Domain (Activity Block Protocol & Runtime)
// ----------------------------------------------------

enum RunStatus {
  CREATED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum RunCloseReason {
  COMPLETED
  ABANDONED
  FAILED
}

enum AssessmentStatus {
  PENDING
  EVALUATED
  SKIPPED
  FAILED
}

model DraftBlockInstance {
  id          String      @id @default(uuid())
  draftId     String
  draft       CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  blockTypeId String
  typeVersion String      @default("1.0.0")
  title       String
  orderIndex  Int         @default(0)
  config      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([draftId])
  @@index([draftId, orderIndex])
  @@map("draft_block_instances")
}

model ABRun {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   CourseVersion   @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  blockInstanceId String
  blockTypeId     String
  typeVersion     String          @default("1.0.0")
  status          RunStatus       @default(CREATED)
  closeReason     RunCloseReason?
  failureDetails  String?
  startedAt       DateTime?
  closedAt        DateTime?
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attempts          ABAttempt[]
  events            ABEvent[]
  assessmentResults AssessmentResult[]
  qualifyingFacts   QualifyingFact[]
  learningEvidence  LearningEvidence[]

  @@index([userId])
  @@index([courseVersionId])
  @@index([courseVersionId, blockInstanceId])
  @@map("ab_runs")
}

model ABAttempt {
  id                String            @id @default(uuid())
  runId             String
  run               ABRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  submittedResponse Json
  assisted          Boolean           @default(false)
  supportContext    Json?
  idempotencyKey    String?
  createdAt         DateTime          @default(now())

  assessmentResult AssessmentResult?
  qualifyingFacts  QualifyingFact[]
  learningEvidence LearningEvidence[]

  @@unique([runId, attemptNumber])
  @@unique([runId, idempotencyKey])
  @@index([runId])
  @@map("ab_attempts")
}

model AssessmentResult {
  id          String           @id @default(uuid())
  attemptId   String?          @unique
  attempt     ABAttempt?       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  runId       String
  run         ABRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  status      AssessmentStatus @default(EVALUATED)
  isCorrect   Boolean?
  score       Float?
  feedback    Json?
  evaluatorId String
  evaluatedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())

  corrections      AssessmentCorrection[]
  qualifyingFacts  QualifyingFact[]
  learningEvidence LearningEvidence[]

  @@index([runId])
  @@map("assessment_results")
}

model ABEvent {
  id              String   @id @default(uuid())
  runId           String
  run             ABRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json?
  idempotencyKey  String?
  serverTimestamp DateTime @default(now())

  @@unique([runId, idempotencyKey])
  @@index([runId])
  @@index([runId, serverTimestamp])
  @@map("ab_events")
}

// ----------------------------------------------------
// OAuth 2.1 & Better Auth MCP Provider Domain
// ----------------------------------------------------

model Jwks {
  id         String    @id @default(uuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(uuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?             @default(now())
  updatedAt                        DateTime?             @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthClientResources             OauthClientResource[]
  oauthRefreshTokens               OauthRefreshToken[]
  oauthAccessTokens                OauthAccessToken[]
  oauthConsents                    OauthConsent[]

  @@index([userId])
  @@map("oauth_clients")
}

model OauthResource {
  id                            String                @id @default(uuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @default(now())
  updatedAt                     DateTime?             @updatedAt
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthClientResources          OauthClientResource[]

  @@map("oauth_resources")
}

model OauthClientResource {
  id            String        @id @default(uuid())
  clientId      String
  oauthClient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthResource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?     @default(now())

  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthRefreshToken {
  id                      String             @id @default(uuid())
  token                   String             @unique
  clientId                String
  oauthClient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthAccessTokens       OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String             @id @default(uuid())
  token                   String?            @unique
  clientId                String
  oauthClient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  oauthRefreshToken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id                      String      @id @default(uuid())
  clientId                String
  oauthClient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?   @default(now())
  updatedAt               DateTime?   @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

model OauthClientAssertion {
  id        String   @id @default(uuid())
  expiresAt DateTime

  @@map("oauth_client_assertions")
}

// ----------------------------------------------------
// MCP Authoring Audit & Idempotency Domain
// ----------------------------------------------------

model McpAuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  toolName       String
  action         String
  resourceType   String
  resourceId     String?
  idempotencyKey String?
  status         String
  details        Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([toolName])
  @@index([idempotencyKey])
  @@index([status])
  @@map("mcp_audit_logs")
}

model McpMutationIdempotency {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String    @default("unknown_client")
  toolName       String
  idempotencyKey String
  payloadHash    String
  resourceId     String?
  ownerToken     String?
  fenceToken     Int       @default(1)
  leaseExpiresAt DateTime?
  status         String    @default("COMPLETED")
  response       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, clientId, toolName, idempotencyKey])
  @@index([userId])
  @@index([clientId])
  @@index([resourceId])
  @@index([status, leaseExpiresAt])
  @@index([fenceToken])
  @@map("mcp_mutation_idempotencies")
}

// ----------------------------------------------------
// Phase 3: Trusted Learning Evidence & Minimal LII Foundation
// ----------------------------------------------------

enum AccessGrantStatus {
  ACTIVE
  REVOKED
}

enum EvidenceClassification {
  UNGRADED_PARTICIPATION
  INDEPENDENT_CORRECT
  ASSISTED_CORRECT
  INCORRECT
  SAME_ITEM_REPETITION
  PENDING_EVALUATION
  EXCLUDED
}

enum EvidenceStatus {
  ACCEPTED
  EXCLUDED
  PENDING_ASSESSMENT
  SUPERSEDED
}

enum LearnerSkillState {
  INSUFFICIENT_EVIDENCE
  DEVELOPING
  READY_TO_VERIFY
}

model CourseAccessGrant {
  id              String            @id @default(uuid())
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   CourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation("LearnerGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedById     String
  grantedBy       User              @relation("GrantedByOwner", fields: [grantedById], references: [id], onDelete: Restrict)
  status          AccessGrantStatus @default(ACTIVE)
  revokedAt       DateTime?
  revokedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([courseVersionId, userId])
  @@index([userId])
  @@index([courseVersionId])
  @@index([courseId])
  @@map("course_access_grants")
}

model CourseSkill {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillCode   String
  name        String
  description String?
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mappings DraftSkillMapping[]

  @@unique([courseId, skillCode])
  @@index([courseId])
  @@map("course_skills")
}

model DraftSkillMapping {
  id              String      @id @default(uuid())
  draftId         String
  draft           CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  blockInstanceId String
  skillId         String
  skill           CourseSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  itemKey         String?
  criterion       String      @default("CORRECT_RESPONSE")
  weight          Float       @default(1.0)
  revision        Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([draftId, blockInstanceId, skillId, itemKey])
  @@index([draftId])
  @@index([skillId])
  @@map("draft_skill_mappings")
}

model LearningEvidence {
  id                   String                 @id @default(uuid())
  sourceKey            String                 @unique
  userId               String
  user                 User                   @relation("UserLearningEvidence", fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId      String
  courseVersion        CourseVersion          @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  skillId              String?
  skillCode            String?
  skillRevision        Int?
  blockInstanceId      String
  blockTypeId          String
  typeVersion          String                 @default("1.0.0")
  runId                String
  run                  ABRun                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptId            String?
  attempt              ABAttempt?             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentResultId   String?
  assessmentResult     AssessmentResult?      @relation(fields: [assessmentResultId], references: [id], onDelete: SetNull)
  eventId              String?
  itemKey              String?
  mappingRevision      Int?
  evaluatorId          String?
  evaluatorVersion     String?
  assessmentStatus     String
  evaluatedAt          DateTime?
  assisted             Boolean                @default(false)
  supportProvenance    String?
  supportContext       Json?
  isCorrect            Boolean?
  score                Float?
  classification       EvidenceClassification
  status               EvidenceStatus         @default(ACCEPTED)
  exclusionReason      String?
  policyVersion        String                 @default("1.0.0")
  isSameItemRepetition Boolean                @default(false)
  repetitionCount      Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([userId, courseVersionId])
  @@index([userId, skillId])
  @@index([runId])
  @@map("learning_evidence")
}

model AssessmentCorrection {
  id                 String           @id @default(uuid())
  assessmentResultId String
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
  revision           Int
  previousStatus     AssessmentStatus
  newStatus          AssessmentStatus
  previousIsCorrect  Boolean?
  newIsCorrect       Boolean?
  previousScore      Float?
  newScore           Float?
  reason             String
  actorId            String
  createdAt          DateTime         @default(now())

  @@unique([assessmentResultId, revision])
  @@index([assessmentResultId])
  @@map("assessment_corrections")
}

model LearnerSkillProjection {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation("UserSkillProjections", fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId  String
  courseVersion    CourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  skillId          String
  skillCode        String
  state            LearnerSkillState @default(INSUFFICIENT_EVIDENCE)
  revision         Int               @default(1)
  policyVersion    String            @default("1.0.0")
  evidenceCount    Int               @default(0)
  independentCount Int               @default(0)
  assistedCount    Int               @default(0)
  incorrectCount   Int               @default(0)
  repeatedCount    Int               @default(0)
  evidenceIds      Json
  reasons          Json
  limitations      Json
  proposedAction   Json?
  lastEvaluatedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([courseVersionId, userId, skillId])
  @@index([userId, courseVersionId])
  @@map("learner_skill_projections")
}

// ----------------------------------------------------
// Phase 4: Course Gamification, Quest Engine & Journey
// ----------------------------------------------------

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REVOKED
}

enum QuestScope {
  COURSE
  GLOBAL
}

enum FactType {
  ACTIVITY_COMPLETED
  INDEPENDENT_PRACTICE_CONFIRMED
}

enum FactState {
  QUALIFIED
  INELIGIBLE
  SUPERSEDED
  REVOKED
}

model CourseEnrollment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   CourseVersion    @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  lastActivityAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questInstances QuestInstance[]

  @@unique([userId, courseVersionId])
  @@index([userId])
  @@index([courseVersionId])
  @@map("course_enrollments")
}

model DraftCourseQuest {
  id           String      @id @default(uuid())
  draftId      String
  draft        CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  questKey     String
  title        String
  description  String?
  templateId   String
  config       Json
  rewardPolicy Json?
  revision     Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([draftId, questKey])
  @@index([draftId])
  @@map("draft_course_quests")
}

model QualifyingFact {
  id                 String            @id @default(uuid())
  sourceKey          String            @unique
  userId             String
  user               User              @relation("UserQualifyingFacts", fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId    String
  courseVersion      CourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  factType           FactType
  blockInstanceId    String
  skillId            String?
  skillCode          String?
  runId              String
  run                ABRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptId          String?
  attempt            ABAttempt?        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentResultId String?
  assessmentResult   AssessmentResult? @relation(fields: [assessmentResultId], references: [id], onDelete: SetNull)
  evidenceId         String?
  policyVersion      String            @default("1.0.0")
  state              FactState         @default(QUALIFIED)
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  consumptions QuestFactConsumption[]

  @@index([userId, courseVersionId])
  @@index([runId])
  @@map("qualifying_facts")
}

model QuestInstance {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation("UserQuestInstances", fields: [userId], references: [id], onDelete: Cascade)
  courseEnrollmentId String?
  courseEnrollment   CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)
  courseVersionId    String?
  courseVersion      CourseVersion?    @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  questKey           String
  templateId         String
  title              String
  description        String?
  scope              QuestScope        @default(COURSE)
  definitionRevision Int               @default(1)
  status             QuestStatus       @default(ACTIVE)
  occurrence         Int               @default(1)
  config             Json?
  rewardPolicy       Json?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  objectives   QuestObjectiveProgress[]
  consumptions QuestFactConsumption[]

  @@unique([courseEnrollmentId, questKey, occurrence])
  @@index([userId, scope, status])
  @@index([courseVersionId])
  @@index([courseEnrollmentId])
  @@map("quest_instances")
}

model QuestObjectiveProgress {
  id              String        @id @default(uuid())
  questInstanceId String
  questInstance   QuestInstance @relation(fields: [questInstanceId], references: [id], onDelete: Cascade)
  objectiveKey    String
  currentCount    Int           @default(0)
  targetCount     Int
  isCompleted     Boolean       @default(false)
  completedAt     DateTime?
  lastEvaluatedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  consumptions QuestFactConsumption[]

  @@unique([questInstanceId, objectiveKey])
  @@index([questInstanceId])
  @@map("quest_objective_progress")
}

model QuestFactConsumption {
  id                  String                 @id @default(uuid())
  questInstanceId     String
  questInstance       QuestInstance          @relation(fields: [questInstanceId], references: [id], onDelete: Cascade)
  objectiveProgressId String
  objectiveProgress   QuestObjectiveProgress @relation(fields: [objectiveProgressId], references: [id], onDelete: Cascade)
  factId              String
  fact                QualifyingFact         @relation(fields: [factId], references: [id], onDelete: Cascade)
  factSourceKey       String
  consumedAt          DateTime               @default(now())
  status              String                 @default("CONSUMED")

  @@unique([questInstanceId, objectiveProgressId, factSourceKey])
  @@index([questInstanceId])
  @@index([factId])
  @@map("quest_fact_consumptions")
}

// ----------------------------------------------------
// Phase 5.5: Assessment & Examination Engine Foundation
// ----------------------------------------------------

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  CLOZE
  SHORT_TEXT
  NUMERIC
  ESSAY
  MATCHING
  ORDERING
}

enum ExamFeedbackPolicy {
  IMMEDIATE
  ON_SUBMISSION
  DEFERRED
  MANUAL
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Reusable Question Bank Item aggregate root owned by creator.
model QuestionBankItem {
  id                    String            @id @default(uuid())
  ownerId               String
  owner                 User              @relation("UserQuestionBankItems", fields: [ownerId], references: [id], onDelete: Cascade)
  courseId              String?
  course                Course?           @relation("CourseQuestionBankItems", fields: [courseId], references: [id], onDelete: SetNull)
  type                  QuestionType
  title                 String
  prompt                String
  content               Json
  answerKey             Json?
  rubric                Json?
  config                Json?
  defaultPoints         Float             @default(1.0)
  skillCode             String?
  difficulty            String?
  tags                  String[]          @default([])
  revision              Int               @default(1)
  publishedVersionCount Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  versions           QuestionVersion[]
  assessmentItemRefs AssessmentItemRef[]

  @@index([ownerId])
  @@index([courseId])
  @@index([type])
  @@map("question_bank_items")
}

/// Immutable Question Version snapshot created upon publication.
model QuestionVersion {
  id                 String           @id @default(uuid())
  questionBankItemId String
  questionBankItem   QuestionBankItem @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)
  versionNumber      Int
  type               QuestionType
  title              String
  prompt             String
  content            Json
  answerKey          Json?
  rubric             Json?
  config             Json?
  defaultPoints      Float
  skillCode          String?
  sourceRevision     Int
  createdById        String
  createdBy          User             @relation("UserCreatedQuestionVersions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  pinnedInItemRefs       AssessmentItemRef[]
  assessmentVersionItems AssessmentVersionItem[]
  examResponses          ExamResponse[]
  examItemGrades         ExamItemGrade[]

  @@unique([questionBankItemId, versionNumber])
  @@index([questionBankItemId])
  @@index([createdById])
  @@map("question_versions")
}

/// Draft Assessment Definition composed of sections and item references.
model AssessmentDefinition {
  id                    String             @id @default(uuid())
  ownerId               String
  owner                 User               @relation("UserAssessmentDefinitions", fields: [ownerId], references: [id], onDelete: Cascade)
  courseId              String?
  course                Course?            @relation("CourseAssessmentDefinitions", fields: [courseId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  instructions          String?
  durationMinutes       Int?
  passingScore          Float?
  maxAttempts           Int?
  feedbackPolicy        ExamFeedbackPolicy @default(ON_SUBMISSION)
  status                ExamStatus         @default(DRAFT)
  revision              Int                @default(1)
  publishedVersionCount Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  sections         AssessmentSection[]
  versions         AssessmentVersion[]
  examAccessGrants ExamAccessGrant[]

  @@index([ownerId])
  @@index([courseId])
  @@map("assessment_definitions")
}

/// Section within an Assessment Definition for grouping and ordering items.
model AssessmentSection {
  id                     String               @id @default(uuid())
  assessmentDefinitionId String
  assessmentDefinition   AssessmentDefinition @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  orderIndex             Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  items AssessmentItemRef[]

  @@index([assessmentDefinitionId])
  @@index([assessmentDefinitionId, orderIndex])
  @@map("assessment_sections")
}

/// Reference to a QuestionBankItem within an AssessmentSection.
model AssessmentItemRef {
  id                      String             @id @default(uuid())
  sectionId               String
  section                 AssessmentSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionBankItemId      String
  questionBankItem        QuestionBankItem   @relation(fields: [questionBankItemId], references: [id], onDelete: Restrict)
  pinnedQuestionVersionId String?
  pinnedQuestionVersion   QuestionVersion?   @relation(fields: [pinnedQuestionVersionId], references: [id], onDelete: SetNull)
  orderIndex              Int                @default(0)
  points                  Float              @default(1.0)
  isRequired              Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([sectionId])
  @@index([sectionId, orderIndex])
  @@index([questionBankItemId])
  @@map("assessment_item_refs")
}

/// Immutable Assessment Version snapshot (published exam blueprint).
model AssessmentVersion {
  id                     String               @id @default(uuid())
  assessmentDefinitionId String
  assessmentDefinition   AssessmentDefinition @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Cascade)
  versionNumber          Int
  idempotencyKey         String?
  title                  String
  description            String?
  instructions           String?
  durationMinutes        Int?
  passingScore           Float?
  maxAttempts            Int?
  feedbackPolicy         ExamFeedbackPolicy
  totalPoints            Float
  itemCount              Int
  snapshot               Json
  draftRevision          Int
  createdById            String
  createdBy              User                 @relation("UserCreatedAssessmentVersions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime             @default(now())

  items    AssessmentVersionItem[]
  attempts ExamAttempt[]

  @@unique([assessmentDefinitionId, versionNumber])
  @@unique([assessmentDefinitionId, idempotencyKey])
  @@index([assessmentDefinitionId])
  @@index([createdById])
  @@index([idempotencyKey])
  @@map("assessment_versions")
}

/// Relational integrity linkage between an AssessmentVersion and pinned QuestionVersions.
model AssessmentVersionItem {
  id                  String            @id @default(uuid())
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  questionVersionId   String
  questionVersion     QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  orderIndex          Int
  points              Float

  @@unique([assessmentVersionId, questionVersionId, orderIndex])
  @@index([assessmentVersionId])
  @@index([questionVersionId])
  @@map("assessment_version_items")
}

// -----------------------------------------------------------------------------
// Phase 5.5: ExamAttempt Runtime, Timed Sessions & Deterministic Auto-Grading
// -----------------------------------------------------------------------------

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  COMPLETED
  ABANDONED
  EXPIRED
}

enum ExamGradeAggregationStatus {
  FULLY_GRADED
  PARTIAL_PENDING_HUMAN
}

/// Explicit exam access grant for standalone assessments or custom enrollments.
model ExamAccessGrant {
  id                     String               @id @default(uuid())
  assessmentDefinitionId String
  assessmentDefinition   AssessmentDefinition @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                 @relation("LearnerExamGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedById            String
  grantedBy              User                 @relation("GrantedByExamCreator", fields: [grantedById], references: [id], onDelete: Restrict)
  status                 AccessGrantStatus    @default(ACTIVE)
  revokedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([assessmentDefinitionId, userId])
  @@index([userId])
  @@index([assessmentDefinitionId])
  @@map("exam_access_grants")
}

/// Server-authoritative examination attempt tied to an immutable AssessmentVersion snapshot.
model ExamAttempt {
  id                  String            @id @default(uuid())
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)
  learnerId           String
  learner             User              @relation("LearnerExamAttempts", fields: [learnerId], references: [id], onDelete: Restrict)
  attemptNumber       Int
  status              ExamAttemptStatus @default(IN_PROGRESS)
  idempotencyKey      String?
  startedAt           DateTime          @default(now())
  deadlineAt          DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  revision            Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  responses ExamResponse[]
  grade     ExamGrade?
  appeals   ExamGradeAppeal[]

  @@unique([assessmentVersionId, learnerId, attemptNumber])
  @@unique([assessmentVersionId, learnerId, idempotencyKey])
  @@index([learnerId])
  @@index([assessmentVersionId])
  @@index([status])
  @@map("exam_attempts")
}

/// Validated learner response payload for a specific published assessment item.
model ExamResponse {
  id                String          @id @default(uuid())
  examAttemptId     String
  examAttempt       ExamAttempt     @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  itemRefId         String
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  responsePayload   Json
  revision          Int             @default(1)
  savedAt           DateTime        @default(now())
  isFinal           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([examAttemptId, itemRefId])
  @@index([examAttemptId])
  @@index([questionVersionId])
  @@map("exam_responses")
}

/// Authoritative examination grade summary calculated upon submission.
model ExamGrade {
  id                 String                     @id @default(uuid())
  examAttemptId      String                     @unique
  examAttempt        ExamAttempt                @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  objectivePoints    Float                      @default(0)
  pendingHumanPoints Float                      @default(0)
  totalAwardedPoints Float                      @default(0)
  maxPossiblePoints  Float
  percentageScore    Float?
  isPassing          Boolean?
  aggregationStatus  ExamGradeAggregationStatus
  evaluatorVersion   String                     @default("ule-exam-evaluator-v1")
  evaluatedAt        DateTime                   @default(now())
  isReleased         Boolean                    @default(false)
  releasedAt         DateTime?
  revision           Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  itemGrades ExamItemGrade[]
  revisions  ExamGradeRevision[]

  @@index([examAttemptId])
  @@map("exam_grades")
}

/// Granular item-level grade observation within an examination.
model ExamItemGrade {
  id                String          @id @default(uuid())
  examGradeId       String
  examGrade         ExamGrade       @relation(fields: [examGradeId], references: [id], onDelete: Cascade)
  itemRefId         String
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  questionType      QuestionType
  maxPoints         Float
  awardedPoints     Float           @default(0)
  isCorrect         Boolean         @default(false)
  isPendingHuman    Boolean         @default(false)
  evaluationDetails Json?
  revision          Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  revisions ExamHumanGradeRevision[]
  appeals   ExamGradeAppeal[]

  @@unique([examGradeId, itemRefId])
  @@index([examGradeId])
  @@index([questionVersionId])
  @@map("exam_item_grades")
}

// ----------------------------------------------------
// Phase 5.5: Human Rubric Grading, Revisions & Appeals
// ----------------------------------------------------

enum ExamGradeRevisionEventType {
  INITIAL_EVALUATION
  CORRECTION
  APPEAL_RESOLUTION
  UNANSWERED_DISPOSITION
}

enum ExamAppealStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_UPHELD
  RESOLVED_CHANGED
  REJECTED
  WITHDRAWN
}

/// Append-only audit ledger for individual human rubric evaluations and corrections.
model ExamHumanGradeRevision {
  id                    String                     @id @default(uuid())
  examItemGradeId       String
  examItemGrade         ExamItemGrade              @relation(fields: [examItemGradeId], references: [id], onDelete: Cascade)
  revision              Int
  actorId               String
  eventType             ExamGradeRevisionEventType @default(INITIAL_EVALUATION)
  previousAwardedPoints Float                      @default(0)
  newAwardedPoints      Float                      @default(0)
  criterionScores       Json?
  comments              String?
  reason                String?
  idempotencyKey        String?
  createdAt             DateTime                   @default(now())

  @@unique([examItemGradeId, revision])
  @@unique([examItemGradeId, idempotencyKey])
  @@index([examItemGradeId])
  @@index([actorId])
  @@map("exam_human_grade_revisions")
}

/// Append-only audit ledger for examination aggregate grade versions.
model ExamGradeRevision {
  id                    String                     @id @default(uuid())
  examGradeId           String
  examGrade             ExamGrade                  @relation(fields: [examGradeId], references: [id], onDelete: Cascade)
  revision              Int
  actorId               String
  eventType             ExamGradeRevisionEventType @default(INITIAL_EVALUATION)
  previousTotalPoints   Float                      @default(0)
  newTotalPoints        Float                      @default(0)
  previousPercentage    Float?
  newPercentage         Float?
  previousPassingStatus Boolean?
  newPassingStatus      Boolean?
  reason                String?
  idempotencyKey        String?
  createdAt             DateTime                   @default(now())

  @@unique([examGradeId, revision])
  @@unique([examGradeId, idempotencyKey])
  @@index([examGradeId])
  @@index([actorId])
  @@map("exam_grade_revisions")
}

/// Learner-initiated grade appeals and resolution workflow.
model ExamGradeAppeal {
  id                         String           @id @default(uuid())
  examAttemptId              String
  examAttempt                ExamAttempt      @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examItemGradeId            String?
  examItemGrade              ExamItemGrade?   @relation(fields: [examItemGradeId], references: [id], onDelete: Cascade)
  learnerId                  String
  learner                    User             @relation("LearnerExamAppeals", fields: [learnerId], references: [id], onDelete: Restrict)
  status                     ExamAppealStatus @default(OPEN)
  reason                     String
  gradeRevisionAtSubmission Int              @default(1)
  reviewerId                 String?
  reviewer                   User?            @relation("ReviewerExamAppeals", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerNotes              String?
  resolution                 String?
  resolvedAt                 DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([examAttemptId])
  @@index([examItemGradeId])
  @@index([learnerId])
  @@index([status])
  @@map("exam_grade_appeals")
}
