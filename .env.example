# ==========================================
# ULE (Universal Learning Engine) Environment
# ==========================================

# --------------------
# Backend (apps/api)
# --------------------
# Node environment (development | test | production)
NODE_ENV=development

# Server port
PORT=3000

# Canonical API prefix
API_PREFIX=api/v1

# Allowed origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# Local Docker Compose default: postgresql://postgres:postgres@localhost:5432/ule_dev?schema=public
# If using a local existing Postgres instance on port 3667:
# DATABASE_URL=postgresql://postgres:your_password@localhost:3667/ule_dev?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ule_dev?schema=public

# --------------------
# Frontend (apps/web)
# --------------------
# Base URL of the NestJS API (Vite requires VITE_ prefix for browser exposure)
VITE_API_BASE_URL=http://localhost:3000
